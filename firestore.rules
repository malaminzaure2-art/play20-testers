rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection rules (both trendboost_users and users)
    match /users/{userId} {
      allow read, write: if true;
    }
    
    match /trendboost_users/{userId} {
      allow read, write: if true;
    }
    
    // Boost campaigns
    match /boost_campaigns/{campaignId} {
      allow read, write: if true;
    }
    
    // Completed tasks
    match /boost_completed_tasks/{taskId} {
      allow read, write: if true;
    }
    
    // Closed testing apps and tasks
    match /apps/{appId} {
      allow read, write: if true;
    }
    
    match /tasks/{taskId} {
      allow read, write: if true;
    }
    
    // Feedback and proofs
    match /proofs/{proofId} {
      allow read, write: if true;
    }
  }
}
