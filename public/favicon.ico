  </defs>
  <rect width="512" height="512" rx="128" fill="url(#bgGrad)" />
  <circle cx="256" cy="256" r="180" fill="white" fill-opacity="0.1" />
  <!-- Play Triangle Icon -->
  <path d="M210 160 L360 256 L210 352 Z" fill="#ffffff" filter="url(#glow)" />
